# PostgreSQL development configuration
POSTGRES_DB=foodmaster
POSTGRES_USER=foodmaster
POSTGRES_PASSWORD=replace-with-a-strong-password

# Used by the future PostgreSQL database adapter.
DATABASE_URL=postgresql://foodmaster:replace-with-a-strong-password@localhost:5434/foodmaster

# Production example: use this instead of the local DATABASE_URL.
# DATABASE_URL=postgresql://foodmaster:replace-with-a-strong-password@168.144.143.203:5555/foodmaster?sslmode=require
